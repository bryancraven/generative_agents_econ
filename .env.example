# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys

OPENROUTER_API_KEY=your-api-key-here

# Example:
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# Note: Copy this file to .env and replace 'your-api-key-here' with your actual API key
# The .env file is in .gitignore and will not be committed to the repository

# Optional: Change the default model in gpt_structure.py
# Default is "xiaomi/mimo-v2-flash:free" (free tier)
# Other options: "openai/gpt-4o-mini", "anthropic/claude-3-haiku", etc.
