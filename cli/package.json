{
  "name": "reverie-cli",
  "version": "1.0.0",
  "description": "Sophisticated CLI UX for Generative Agents Simulation",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "reverie-cli": "./bin/reverie-cli.js"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun",
    "dev": "bun --watch src/index.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.2.0",
    "ws": "^8.16.0",
    "chalk": "^5.3.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "ink-select-input": "^5.0.0",
    "ink-box": "^3.0.0",
    "date-fns": "^3.0.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
